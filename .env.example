# Copy this file to .env and adjust before running docker compose up

# Secret used to sign admin JWTs — change this to something long & random
JWT_SECRET=please-change-this-to-a-long-random-string

# Where the frontend is allowed to call the API from
CORS_ORIGINS=http://localhost:3000

# The first admin account created when the database is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Where the browser should reach the API (must be reachable from the visitor's device)
NEXT_PUBLIC_API_URL=http://localhost:8000
